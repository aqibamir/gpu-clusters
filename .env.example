# ---- Shared secret (same value on orchestrator + all nodes + clients) ----
API_KEY=change-me-to-a-long-random-string

# ---- Orchestrator (Railway sets PORT automatically) ----
DB_PATH=/data/orchestrator.db    # /data is the Railway persistent volume

# ---- Cloud GPU node (vLLM) ----
# The model is downloaded from HuggingFace on first start (~15 GB for 70B, ~15 GB for 7B)
MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
TENSOR_PARALLEL_SIZE=1           # number of GPUs on this VM (set >1 for multi-GPU)
GPU_MEMORY_UTIL=0.90
GPU_NAME=                        # auto-detected from nvidia-smi in start_node_gpu.sh
HF_TOKEN=                        # HuggingFace token (required for gated models like Llama-3)

ORCHESTRATOR_URL=https://your-app.up.railway.app
NODE_BASE_URL=http://<your-vm-public-ip>:8001
NODE_ID=my-a100-node             # optional, defaults to hostname

# ---- Mac local testing (llama.cpp, no CUDA) ----
# MODEL_PATH=./models/mistral-7b-instruct-v0.2.Q4_K_M.gguf

# ---- Ray worker (for 70B+ multi-VM distributed inference) ----
# RAY_HEAD_IP=<primary-vm-ip>
# RAY_PORT=6379

# ---- Hugging Face (avoid rate limits) ----
# HF_TOKEN=hf_...
