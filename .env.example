# ---- Shared secret (set the same value on orchestrator + all nodes + clients) ----
API_KEY=change-me-to-a-long-random-string

# ---- Node agent (runs on each Mac) ----
MODEL_PATH=./models/mistral-7b-instruct-v0.2.Q4_K_M.gguf
ORCHESTRATOR_URL=https://your-app.up.railway.app   # or http://localhost:8000 locally
NODE_ID=my-mac-node
NODE_BASE_URL=http://192.168.1.x:8001              # this machine's address as seen from orchestrator

# ---- Orchestrator (Railway sets PORT automatically) ----
DB_PATH=/data/orchestrator.db                      # /data is the Railway persistent volume

# ---- Hugging Face (optional, avoids rate limits on model download) ----
# HF_TOKEN=hf_...
